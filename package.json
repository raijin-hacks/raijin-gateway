{
  "name": "calhacks-13-0",
  "version": "0.1.0",
  "private": true,
  "description": "Cal Hacks 13.0 project",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
