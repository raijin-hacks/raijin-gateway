# Copy to .env and fill in the blanks. Never commit .env.

# At least 16 characters.
ADMIN_TOKEN=
# Relative paths resolve from apps/gateway.
DATABASE_PATH=./gateway.db
# Optional: CATALOG_PATH (default ../../catalog/catalog.json), PORT (default 4000).

# Testnet only. Never a mainnet key.
WALLET_PRIVATE_KEY=
FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-5

# {"<merchant origin>": "<api key>"}
MERCHANT_KEYS_JSON={}

# real | mock
PAYMENTS_MODE=mock
# real | stub-escalate | stub-approve
JUDGE_MODE=stub-escalate
