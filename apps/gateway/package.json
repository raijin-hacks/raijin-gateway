{
  "name": "@apf/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "payments:wallets": "tsx src/payments/scripts/gen-wallets.ts",
    "payments:balance": "tsx --env-file-if-exists=../../.env src/payments/scripts/balance.ts",
    "payments:pay-once": "tsx --env-file-if-exists=../../.env src/payments/scripts/pay-once.ts"
  },
  "dependencies": {
    "@apf/contracts": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "ulid": "3.0.2",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
