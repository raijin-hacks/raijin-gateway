{
  // Typecheck-only pass for code outside the project builds: Chunk 3's eval/ scripts and tests
  // colocated in src/. They use bundler-style imports (extensionless paths, JSON imports across
  // packages) that the NodeNext project builds in tsconfig.json can't compile.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": { "@apf/contracts": ["./packages/contracts/src/index.ts"] }
  },
  "include": ["eval/**/*.ts", "packages/*/src/**/*.test.ts", "apps/*/src/**/*.test.ts"]
}
